<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" alignment="CENTER_LEFT" spacing="4"
      xmlns="http://javafx.com/javafx/25.0.3" xmlns:fx="http://javafx.com/fxml/1">
  <padding><Insets top="9" right="8" bottom="9" left="12" /></padding>
  <Label fx:id="id" styleClass="cell_small_label">
    <minWidth><Region fx:constant="USE_PREF_SIZE" /></minWidth>
  </Label>
  <VBox spacing="2" HBox.hgrow="ALWAYS">
    <Label fx:id="clientReference" styleClass="cell_small_label" />
    <Label fx:id="name" styleClass="cell_big_label" />
  </VBox>
</HBox>
