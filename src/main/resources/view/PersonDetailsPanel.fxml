<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="client-details"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <content>
    <VBox spacing="10">
      <padding><Insets top="15" right="15" bottom="15" left="15" /></padding>
      <Label fx:id="emptyMessage" text="No client selected." />
      <VBox fx:id="details" spacing="10">
        <Label fx:id="reference" wrapText="true" maxWidth="Infinity" />
        <Label fx:id="name" wrapText="true" maxWidth="Infinity" />
        <Label fx:id="phone" wrapText="true" maxWidth="Infinity" />
        <Label fx:id="email" wrapText="true" maxWidth="Infinity" />
        <Label fx:id="address" wrapText="true" maxWidth="Infinity" />
        <Label fx:id="serviceNote" wrapText="true" maxWidth="Infinity" />
        <Label fx:id="cardDetails" wrapText="true" maxWidth="Infinity" />
        <Label fx:id="creditScore" wrapText="true" maxWidth="Infinity" />
        <Label fx:id="debt" wrapText="true" maxWidth="Infinity" />
        <FlowPane fx:id="tags" hgap="7" vgap="3" />
      </VBox>
    </VBox>
  </content>
</ScrollPane>
