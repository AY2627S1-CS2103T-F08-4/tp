@startuml
!include style.puml
skinparam ArrowFontStyle plain

Actor User as user USER_COLOR
Participant ":UI" as ui UI_COLOR
Participant ":Logic" as logic LOGIC_COLOR
Participant "active:Model" as model MODEL_COLOR
Participant "stage:ModelStage" as stage MODEL_COLOR
Participant "staged:Model" as staged MODEL_COLOR
Participant ":Storage" as storage STORAGE_COLOR

user -[USER_COLOR]> ui : "delete 1"
activate ui UI_COLOR

ui -[UI_COLOR]> logic : execute("delete 1")
activate logic LOGIC_COLOR

logic -[LOGIC_COLOR]> model : beginStaging(clock)
model --[MODEL_COLOR]> logic : stage
logic -[LOGIC_COLOR]> stage : model()
stage --[MODEL_COLOR]> logic : staged

note over logic, staged : DeleteCommand executes against the staged model
logic -[LOGIC_COLOR]> staged : deletePerson(p)
staged --[MODEL_COLOR]> logic

alt save succeeds
    logic -[LOGIC_COLOR]> storage : saveAddressBook(staged address book)\nvia AddressBookSync
    activate storage STORAGE_COLOR
    storage --[STORAGE_COLOR]> logic : saved
    deactivate storage
    logic -[LOGIC_COLOR]> stage : commit()
    stage -[MODEL_COLOR]> model : publish staged data and filter
    model --[MODEL_COLOR]> stage
    stage --[MODEL_COLOR]> logic
    logic --[LOGIC_COLOR]> ui : CommandResult
else save fails
    logic -[LOGIC_COLOR]> storage : saveAddressBook(staged address book)\nvia AddressBookSync
    activate storage STORAGE_COLOR
    storage --[STORAGE_COLOR]> logic : error
    deactivate storage
    note over model, staged : Active data and filter remain unchanged; stage is discarded
    logic --[LOGIC_COLOR]> ui : CommandException\nUnable to save client data. No changes were made.
end

deactivate logic

ui--[UI_COLOR]> user
deactivate ui
@enduml
